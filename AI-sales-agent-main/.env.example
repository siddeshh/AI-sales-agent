# AI Sales Agent — Environment Configuration

PROJECT_NAME="AI Sales Agent — Autonomous Multi-Agent Sales Workforce"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="ai-sales-workforce-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite out-of-the-box or PostgreSQL)
DATABASE_URL="sqlite:///./sales_workforce.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sales_workforce"

# AI Reasoning Engine Configuration (copy this file to backend/.env)
# LLM_PROVIDER: "groq" (default, model llama-3.3-70b-versatile)
#               "openai" (model gpt-4o-mini)
#               "ollama" (local, http://localhost:11434, model llama3.1, no key needed)
#               "mock"   (never call a model; always use the rule-based fallback)
# If the key is missing or the call fails (20 s timeout, 1 retry), agents fall back to
# the rule-based templates and the message is stored with provider="rules".
LLM_PROVIDER="groq"
# LLM_MODEL: optional override of the provider's default model (e.g. "qwen2.5:3b" for ollama)
LLM_MODEL=""
DEMO_MODE=true

# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=""
# Only needed when LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Knowledge base (RAG)
# Embeddings: sentence-transformers all-MiniLM-L6-v2 (384-dim, CPU). Downloaded (~90 MB) on first start.
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# VECTOR_STORE: "sqlite" (default, vectors stored as JSON in the DB) or "qdrant".
#   qdrant needs `pip install qdrant-client`; with QDRANT_URL empty it runs embedded on disk at QDRANT_PATH (no server).
#   After switching store or embedding model run:  python scripts\reindex.py
VECTOR_STORE="sqlite"
RAG_TOP_K=4
# Chunks below this cosine similarity are ignored; if none pass, the agent says it will check and get back.
RAG_SIMILARITY_THRESHOLD=0.35
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_PATH="./qdrant_data"

# Default Industry Playbook
# Single demo business: Celestial Wear (retail apparel)
DEFAULT_INDUSTRY="retail"
