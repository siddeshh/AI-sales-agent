# AI Sales Agent — Environment Configuration

PROJECT_NAME="AI Sales Agent — Autonomous Multi-Agent Sales Workforce"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="ai-sales-workforce-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite out-of-the-box or PostgreSQL)
DATABASE_URL="sqlite:///./sales_workforce.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sales_workforce"

# AI Reasoning Engine Configuration
# Options: "mock" (100% offline local demo mode), "openai", "anthropic", "groq", "ollama"
LLM_PROVIDER="mock"
DEMO_MODE=true

# External LLM Keys (Optional - only required if LLM_PROVIDER is not "mock")
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Qdrant Vector Database (Optional - falls back to embedded semantic vector index)
QDRANT_URL=""
QDRANT_API_KEY=""

# Default Industry Playbook
# Options: "real_estate", "saas", "edtech", "automotive", "b2b_services"
DEFAULT_INDUSTRY="real_estate"
